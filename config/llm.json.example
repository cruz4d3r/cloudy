{
  "_comment": "Motor multi-cloud del LLM de Cloudy. Copia a config/llm.json (gitignored). Mac: cursor → cloud → local → katana. Edge: omite cursor y ollama_local.",
  "cooldown_seconds": 900,
  "profiles": {
    "whatsapp": {
      "chain_labels": [
        "ollama-cloud",
        "groq-gpt-oss",
        "groq-llama",
        "gemini-flash",
        "openrouter",
        "local",
        "openai-katana"
      ]
    },
    "batch": {
      "chain_labels": [
        "local",
        "openrouter",
        "gemini-flash",
        "ollama-cloud",
        "groq-llama",
        "groq-gpt-oss",
        "openai-katana"
      ]
    },
    "chatwoot": {
      "chain_labels": [
        "groq-llama",
        "gemini-flash",
        "openrouter",
        "ollama-cloud",
        "groq-gpt-oss"
      ]
    }
  },
  "chain": [
    {
      "type": "cursor",
      "label": "cursor-local-auto",
      "model": "auto",
      "runtime": "local",
      "api_key_file": "config/cursor.json",
      "timeout": 120,
      "enabled": true,
      "mac_only": true,
      "channels": ["webchat", "edge"],
      "_note": "Mac webhook — Cursor SDK local. PROHIBIDO en whatsapp."
    },
    {
      "type": "cursor",
      "label": "cursor-cloud-auto",
      "model": "auto",
      "runtime": "cloud",
      "api_key_file": "config/cursor.json",
      "timeout": 120,
      "enabled": true,
      "allow_on_mac": true,
      "channels": ["webchat", "edge"]
    },
    {
      "type": "ollama_cloud",
      "label": "ollama-cloud",
      "model": "gpt-oss:120b-cloud",
      "enabled": true
    },
    {
      "type": "openai_compatible",
      "label": "groq-gpt-oss",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_file": "config/groq-api-key.txt",
      "model": "openai/gpt-oss-120b",
      "enabled": true
    },
    {
      "type": "openai_compatible",
      "label": "groq-llama",
      "base_url": "https://api.groq.com/openai/v1",
      "api_key_file": "config/groq-api-key.txt",
      "model": "llama-3.3-70b-versatile",
      "enabled": true
    },
    {
      "type": "openai_compatible",
      "label": "gemini-flash",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "api_key_file": "config/gemini-api-key.txt",
      "model": "gemini-2.5-flash",
      "image_model": "gemini-2.5-flash-image",
      "enabled": true
    },
    {
      "type": "openai_compatible",
      "label": "openrouter",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_file": "config/openrouter-api-token.txt",
      "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "enabled": true
    },
    {
      "type": "ollama_local",
      "label": "local",
      "model": "qwen3.5:9b",
      "enabled": true,
      "_note": "Solo Mac — filtrado en Edge."
    },
    {
      "type": "katana",
      "label": "openai-katana",
      "enabled": true
    }
  ]
}
